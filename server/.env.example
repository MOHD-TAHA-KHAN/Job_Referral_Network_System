# ═══════════════════════════════════════════════════════════════════════════
# RefNet Backend Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════

# ─── DATABASE ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
# Format: postgresql://username:password@host:port/database
# Example (Supabase): postgresql://postgres.xxxxx:password@db.xxxxx.supabase.co:5432/postgres
PG_URI=postgresql://postgres:password@localhost:5433/referraldb

# ─── AUTHENTICATION ──────────────────────────────────────────────────────────
# JWT Secrets (min 32 characters each, use strong random values in production)
JWT_SECRET=your_jwt_secret_here_change_in_production_min_32_chars_required
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_change_in_production_min_32_chars

# Session secret (separate from JWT, for express-session)
SESSION_SECRET=your_session_secret_here_change_in_production_min_32_chars

# Google OAuth 2.0 Credentials (required)
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google OAuth Callback URL (for production)
# Format: https://yourbackend.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─── FILE STORAGE ────────────────────────────────────────────────────────────
# Cloudinary URL for image/resume uploads (required)
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://key:secret@cloudname

# ─── SERVER ──────────────────────────────────────────────────────────────────
# Port number (will fallback to 5000-5002 if taken)
PORT=5000

# Environment mode: development, staging, production
NODE_ENV=development

# ─── FRONTEND ────────────────────────────────────────────────────────────────
# Frontend URL (required, for CORS and OAuth redirects)
# Comma-separated list of allowed origins in production
# Example: https://yourfrontend.vercel.app,https://yourdomain.com
CLIENT_URL=http://localhost:5173

# API base URL (for certain OAuth flows)
API_URL=http://localhost:5000

# ─── LOGGING & MONITORING ───────────────────────────────────────────────────
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════════════════
# DEPLOYMENT GUIDE:
# ═══════════════════════════════════════════════════════════════════════════
# 
# SUPABASE + VERCEL DEPLOYMENT:
# 
# 1. Supabase Database Setup:
#    - Create a Supabase project
#    - Get connection string from: Project Settings → Database → Connection String
#    - Format: postgresql://postgres.xxxxx:password@db.xxxxx.supabase.co:5432/postgres
#
# 2. Vercel Backend Deployment:
#    - Push your code to GitHub
#    - Create new Vercel project from GitHub repo
#    - Add Environment Variables in Vercel Dashboard:
#      Settings → Environment Variables
#    - Deploy
#
# 3. Update Secrets:
#    - Generate strong secrets:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    - Use unique values for JWT_SECRET, JWT_REFRESH_SECRET, SESSION_SECRET
#
# 4. CORS Configuration:
#    - CLIENT_URL must match your Vercel frontend URL
#    - For multiple domains: https://app.vercel.app,https://yourdomain.com
#
# 5. Google OAuth Setup:
#    - Go to: https://console.cloud.google.com/
#    - Create OAuth 2.0 credentials
#    - Add Authorized redirect URIs:
#      - http://localhost:5000/api/auth/google/callback (dev)
#      - https://your-backend-url.vercel.app/api/auth/google/callback (prod)
#
# ═══════════════════════════════════════════════════════════════════════════
