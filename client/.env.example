# ═══════════════════════════════════════════════════════════════════════════
# RefNet Frontend Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════

# ─── API CONFIGURATION ───────────────────────────────────────────────────────
# Backend API URL (required)
# Development: http://localhost:5000/api
# Production: https://your-backend.vercel.app/api
VITE_API_URL=http://localhost:5000/api

# ─── GOOGLE OAUTH ────────────────────────────────────────────────────────────
# Google OAuth Client ID (required)
# Get from: https://console.cloud.google.com/
# Must match the one used in backend
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ─── APPLICATION METADATA ───────────────────────────────────────────────────
# Application name
VITE_APP_NAME=RefNet

# Application version
VITE_APP_VERSION=1.0.0

# ─── OPTIONAL FEATURES ──────────────────────────────────────────────────────
# Analytics and monitoring (optional)
VITE_ENABLE_ANALYTICS=true

# Sentry DSN for error tracking (optional)
VITE_SENTRY_DSN=

# ═══════════════════════════════════════════════════════════════════════════
# DEPLOYMENT GUIDE:
# ═══════════════════════════════════════════════════════════════════════════
# 
# VERCEL DEPLOYMENT:
# 
# 1. GitHub Integration:
#    - Connect your GitHub repo to Vercel
#    - Vercel will auto-detect this is a Vite project
#
# 2. Build Configuration:
#    - Build Command: npm run build
#    - Output Directory: dist
#    - Install Command: npm install (auto-detected)
#
# 3. Environment Variables:
#    - Settings → Environment Variables
#    - Add VITE_API_URL pointing to your backend
#    - Add VITE_GOOGLE_CLIENT_ID
#
# 4. Example Production Values:
#    - VITE_API_URL=https://your-backend.vercel.app/api
#    - VITE_GOOGLE_CLIENT_ID=<your-production-client-id>
#
# ═══════════════════════════════════════════════════════════════════════════
